{
    "seed": 2025,
    "_comment_cuda": "single-GPU training uses cuda_visible_devices; DDP training is managed by torchrun and ignores this",
    "cuda_visible_devices": "0",
    "hf_endpoint": "https://hf-mirror.com",
    "_comment_data": "===== .npy + metadata.csv data paths =====",
    "npy_dir": "data/ukb_healthy_npy/images_npy/",
    "metadata_csv": "data/ukb_healthy_npy/metadata.csv",
    "ckpt_path": "",
    "out_dir": "results/",
    "_comment_model": "===== model =====",
    "model_type": "swin3d",
    "_comment_label": "===== label =====",
    "label_sigma": 1,
    "label_smoothing": 0.001,
    "_comment_train": "===== training (batch_size is per-GPU; under DDP total batch = batch_size x #GPUs) =====",
    "epochs": 50,
    "batch_size_train": 64,
    "batch_size_eval": 64,
    "num_workers_train": 8,
    "num_workers_eval": 8,
    "prefetch_factor": 2,
    "lr": 0.001,
    "weight_decay": 0.0005,
    "head_dropout": 0.3,
    "backbone_lr": 7e-05,
    "backbone_weight_decay": 0.001,
    "scale_lr": false,
    "min_lr": 5e-05,
    "grad_clip_norm": 1.0,
    "warmup_epochs": 1,
    "_comment_freeze": "===== backbone freezing =====",
    "freeze_until_epoch": 0,
    "freeze_norm": true,
    "bb_unfreeze_warmup_epochs": 5,
    "bb_unfreeze_start_ratio": 0.1,
    "_comment_loss": "===== loss weights =====",
    "kl_weight": 1.0,
    "reg_weight": 0.3,
    "reg_type": "l1",
    "reg_warmup_epochs": 1,
    "dual_anneal": false,
    "_comment_evi": "===== evidential head =====",
    "use_residual_head": false,
    "residual_hidden": 48,
    "residual_dropout": 0.2,
    "residual_scale": 2.0,
    "use_evidential_head": false,
    "evi_hidden": 48,
    "evi_dropout": 0.2,
    "evi_weight": 0.0,
    "evi_reg_weight": 0.001,
    "evi_start_epoch": 5,
    "evi_warmup_epochs": 5,
    "evi_detach_backbone": true,
    "clip_logp_min": -50,
    "_comment_aug": "===== augmentation (GPU) =====",
    "augment": true,
    "gpu_aug": true,
    "gpu_aug_rot_deg": 10,
    "gpu_aug_translate_frac": [
        0.1,
        0.1,
        0.1
    ],
    "gpu_aug_p": 0.5,
    "gpu_aug_padding_mode": "border",
    "gpu_aug_p_intensity": 0.7,
    "gpu_aug_gamma_range": [
        0.9,
        1.1
    ],
    "gpu_aug_noise_std": 0.02,
    "_comment_bias": "===== bias correction =====",
    "bias_min_epoch": 10,
    "bias_den_eps": 0.001,
    "bias_max_abs_alpha": 0.9,
    "bias_min_corr": 0.3,
    "_comment_amp": "===== AMP =====",
    "use_amp": true,
    "amp_dtype": "bf16",
    "_comment_early_stop": "===== early stopping =====",
    "early_stop_patience": 10,
    "_comment_resume": "===== resume =====",
    "resume": false,
    "resume_metric": "last",
    "_comment_model_cfg": "===== Swin3D model parameters =====",
    "model": {
        "in_channels": 1,
        "feat_channels": 128,
        "embed_dim": 32,
        "depths": [
            2,
            2,
            2,
            2
        ],
        "num_heads": [
            2,
            4,
            8,
            16
        ],
        "window_size": [
            8,
            8,
            8
        ],
        "patch_size": [
            4,
            4,
            4
        ],
        "spatial_dims": 3,
        "mlp_ratio": 4.0,
        "drop_rate": 0.1,
        "attn_drop_rate": 0,
        "drop_path_rate": 0.1,
        "use_checkpoint": false,
        "use_v2": true,
        "feat_index": -1,
        "downsample": "merging",
        "head_hidden": 64,
        "head_dropout": 0.4,
        "freeze_stages": 0,
        "freeze_backbone": false,
        "freeze_norm": true
    },
    "_comment_plot": "===== plotting =====",
    "plot_every": 1,
    "print_weight_every": 1
}